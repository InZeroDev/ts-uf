{
	"name": "@inzero/ts-uf",
	"version": "0.0.1",
	"description": "TypeScript utility functions",
	"keywords": [
		"typescript",
		"utility",
		"functions"
	],
	"license": "MIT",
	"author": "InZero",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "tsc --noEmit; eslint src/**/*.ts",
		"format": "prettier --write .",
		"barrel:check:main": "barrel check src/** --create --extension ts",
		"barrel:check:types": "touch src/types.ts",
		"barrel:generate:main": "barrel generate src/**/index.ts -e _* types.ts",
		"barrel:generate:types": "barrel generate src/types.ts -i '**/types.ts' -e '**/_*' -E '*'",
		"barrel": "npm-run-all barrel:check:* barrel:generate:*",
		"gen-barrel": "barrel check src src/* --extension ts --create; barrel src/index.ts src/*/index.ts",
		"prepublish": "pnpm gen-barrel; pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inzero/barrel": "0.1.0",
		"@inzero/ts-ut": "0.2.0",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.10",
		"prettier-plugin-packagejson": "^3.0.2",
		"tsup": "^9.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.0"
	},
	"packageManager": "pnpm@12.14.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		}
	}
}
