{
	"name": "@inzero/ts-uf",
	"version": "0.4.0",
	"description": "TypeScript utility functions",
	"keywords": [
		"typescript",
		"utility",
		"functions"
	],
	"homepage": "https://ts-uf.vercel.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/InZeroDev/ts-uf",
		"directory": "package"
	},
	"license": "MIT",
	"author": "InZero",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts"
		},
		"./string": {
			"types": "./dist/string/index.d.ts",
			"default": "./dist/string/index.js"
		},
		"./number": {
			"types": "./dist/number/index.d.ts",
			"default": "./dist/number/index.js"
		},
		"./boolean": {
			"types": "./dist/boolean/index.d.ts",
			"default": "./dist/boolean/index.js"
		},
		"./array": {
			"types": "./dist/array/index.d.ts",
			"default": "./dist/array/index.js"
		},
		"./object": {
			"types": "./dist/object/index.d.ts",
			"default": "./dist/object/index.js"
		},
		"./function": {
			"types": "./dist/function/index.d.ts",
			"default": "./dist/function/index.js"
		},
		"./math": {
			"types": "./dist/math/index.d.ts",
			"default": "./dist/math/index.js"
		},
		"./other": {
			"types": "./dist/other/index.d.ts",
			"default": "./dist/other/index.js"
		},
		"./regex": {
			"types": "./dist/regex/index.d.ts",
			"default": "./dist/regex/index.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"package.json"
	],
	"scripts": {
		"barrel:check": "barrel check src/* --create --extension ts",
		"barrel:generate": "barrel generate src/*/index.ts",
		"barrel:main": "pnpm run barrel:check; pnpm run barrel:generate",
		"build": "tsup",
		"dev": "tsup --watch",
		"format": "prettier --write .",
		"lint": "tsc --noEmit; eslint src/**/*.ts",
		"prepublish": "pnpm barrel:main; pnpm build"
	},
	"dependencies": {
		"@inzero/ts-ut": "^0.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inzero/barrel": "^0.1.0",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.10",
		"prettier-plugin-packagejson": "^3.0.2",
		"tsup": "^9.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.0"
	},
	"packageManager": "pnpm@12.14.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		}
	}
}
